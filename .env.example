# Postgres connection string (Neon via Vercel Marketplace, Supabase, etc.).
# Leave empty in local dev to use embedded Postgres stored in .data/
DATABASE_URL=

# Required in production. Generate with: openssl rand -base64 48
SESSION_SECRET=

# ── AI ─────────────────────────────────────────────────────────────────────
# Google Gemini (used when set). Create a key at https://aistudio.google.com/apikey
# On Vercel add it under Settings → Environment Variables and mark it Sensitive.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional Gemini model name. Leave empty and the app tries gemini-flash-latest, gemini-3.8-flash and
# gemini-2.5-flash in turn and remembers the one that works (Google retires model names often).
GEMINI_MODEL=
# How hard the model thinks before answering: none | minimal | low | medium | high (default: low).
# Higher is slower; newer Gemini models can otherwise think for minutes before the first word.
AI_REASONING=
# Time limits in seconds: whole request (default 120), wait for the first word (60), longest pause (30).
AI_TIMEOUT_SECONDS=
AI_FIRST_CHUNK_SECONDS=
AI_CHUNK_GAP_SECONDS=
# Only for a corporate proxy in front of the Gemini API.
GEMINI_BASE_URL=

# Fallback when no Gemini key is set: Vercel AI Gateway
# (no key needed when deployed on Vercel with a payment card on the account).
AI_GATEWAY_API_KEY=
# Optional Gateway model, "provider/model"
AI_MODEL=anthropic/claude-sonnet-4.6
