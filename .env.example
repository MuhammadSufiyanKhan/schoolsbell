# Postgres connection string (Neon via Vercel Marketplace, Supabase, etc.).
# Leave empty in local dev to use embedded Postgres stored in .data/
DATABASE_URL=

# Required in production. Generate with: openssl rand -base64 48
SESSION_SECRET=

# ── AI ─────────────────────────────────────────────────────────────────────
# Which service answers: set ONE key. If several are set, the first of Groq → Gemini → Gateway wins,
# unless AI_PROVIDER (groq | google | gateway) forces one.
AI_PROVIDER=

# Groq (recommended: very fast). Create a key at https://console.groq.com/keys
# On Vercel add it under Settings → Environment Variables and mark it Sensitive. Redeploy afterwards.
GROQ_API_KEY=
# Optional pin. Leave empty and the app tries openai/gpt-oss-120b, openai/gpt-oss-20b, then
# moonshotai/kimi-k2-instruct-0905, and remembers whichever works (providers retire models often).
GROQ_MODEL=
# Only for a proxy in front of Groq.
GROQ_BASE_URL=

# Google Gemini. Create a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional pin. Empty = tries gemini-flash-latest, gemini-3.8-flash, gemini-2.5-flash in turn.
GEMINI_MODEL=
# Only for a corporate proxy in front of the Gemini API.
GEMINI_BASE_URL=

# How hard the model thinks before answering: none | minimal | low | medium | high (default: low).
# Higher is slower.
AI_REASONING=
# Time limits in seconds: whole request (default 120), wait for the first word (60), longest pause (30).
AI_TIMEOUT_SECONDS=
AI_FIRST_CHUNK_SECONDS=
AI_CHUNK_GAP_SECONDS=

# Last resort: Vercel AI Gateway (needs a payment card on the Vercel account, or its own key).
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.6
