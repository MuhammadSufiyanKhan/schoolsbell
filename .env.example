# Postgres connection string (Neon via Vercel Marketplace, Supabase, etc.).
# Leave empty in local dev to use embedded Postgres stored in .data/
DATABASE_URL=

# Required in production. Generate with: openssl rand -base64 48
SESSION_SECRET=

# ── AI ─────────────────────────────────────────────────────────────────────
# The AI Assistant, AI test generation and AI grading run on Groq (very fast).
# Create a key at https://console.groq.com/keys
# On Vercel add it under Settings → Environment Variables and mark it Sensitive. Redeploy afterwards.
GROQ_API_KEY=
# Optional pin. Leave empty and the app tries openai/gpt-oss-120b, openai/gpt-oss-20b, then
# moonshotai/kimi-k2-instruct-0905, and remembers whichever works (Groq retires models now and then).
GROQ_MODEL=
# Optional pin for reading photographed lessons (vision). Leave empty to try meta-llama/llama-4-scout-17b-16e-instruct,
# then meta-llama/llama-4-maverick-17b-128e-instruct.
GROQ_VISION_MODEL=
# Only for a proxy in front of Groq.
GROQ_BASE_URL=

# How hard the model thinks before answering: none | minimal | low | medium | high (default: low).
# Higher is slower.
AI_REASONING=
# Time limits in seconds: whole request (default 120), wait for the first word (60), longest pause (30).
AI_TIMEOUT_SECONDS=
AI_FIRST_CHUNK_SECONDS=
AI_CHUNK_GAP_SECONDS=

# PDF export of tests runs Chromium. On Vercel it is bundled automatically; elsewhere set the path if it isn't found
# in the usual places (/usr/bin/chromium, /usr/bin/google-chrome …).
CHROME_PATH=
